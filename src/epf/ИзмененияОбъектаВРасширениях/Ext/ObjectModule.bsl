#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Ищет объект метаданных во всех расширениях, записанных в информационную базу
// (в том числе отключенных), и описывает, что каждое расширение в нем меняет.
// Состав объекта берется из метаданных расширения, а код модулей и изменения
// заимствованных форм - из двоичных данных расширения (см. АнализДанныхРасширения).
// Чтение расширений требует административных прав.
//
// Параметры:
//   ПолноеИмя - Строка - полное имя объекта, например "Справочник.ДоговорыКонтрагентов".
//                        Пустая строка - все объекты всех расширений.
//   ТолькоИзменения - Булево - не выводить объекты, которые расширение только заимствует
//                     (нет своих элементов, кода в модулях и изменений в формах),
//                     и заимствованные элементы без изменений.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки:
//     * Объект - Строка - полное имя объекта.
//     * Расширение - Строка - имя расширения.
//     * Синоним - Строка - синоним расширения.
//     * Версия - Строка - версия расширения.
//     * Активно - Булево - расширение включено.
//     * БезопасныйРежим - Булево - расширение работает в безопасном режиме.
//     * ИзменяетСтруктуруДанных - Булево - расширение меняет структуру данных.
//     * Назначение - Строка - назначение расширения.
//     * Элемент - Строка - "(объект)", подчиненный элемент, например "Реквизит.Комментарий",
//                          или модуль, например "МодульОбъекта".
//     * ВидИзменения - Строка - "новый", "заимствован", "заимствован, изменен" или "код".
//     * Подробности - Строка - перехваты методов, что изменено в форме, причина, по которой
//                              код не удалось проверить.
//     * Порядок - Число - 0 - сам объект, 1 - изменение, 2 - заимствованный без изменений.
//
Функция ИзмененияОбъекта(Знач ПолноеИмя = "", ТолькоИзменения = Ложь) Экспорт

	Результат = НоваяТаблицаИзменений();
	ПолноеИмя = СокрЛП(ПолноеИмя);

	Расширения = РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.БазаДанных);
	Для Каждого Расширение Из Расширения Цикл

		ДанныеРасширения = Расширение.ПолучитьДанные();
		МетаданныеРасширения = Новый ОбъектМетаданныхКонфигурация(ДанныеРасширения);

		Если ЗначениеЗаполнено(ПолноеИмя) Тогда
			ОбъектыРасширения = Новый Массив;
			ОбъектРасширения = МетаданныеРасширения.НайтиПоПолномуИмени(ПолноеИмя);
			Если ОбъектРасширения <> Неопределено Тогда
				ОбъектыРасширения.Добавить(ОбъектРасширения);
			КонецЕсли;
		Иначе
			ОбъектыРасширения = ОбъектыВерхнегоУровня(МетаданныеРасширения);
		КонецЕсли;

		Если ОбъектыРасширения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Анализ = АнализДанныхРасширения(ДанныеРасширения, ОбъектыРасширения);

		Для Каждого ОбъектРасширения Из ОбъектыРасширения Цикл
			ДобавитьИзмененияОбъекта(Результат, Расширение, ОбъектРасширения,
				Анализ[ОбъектРасширения.ПолноеИмя()], ТолькоИзменения);
		КонецЦикла;

	КонецЦикла;

	Результат.Сортировать("Объект, Расширение, Порядок, Элемент");
	Возврат Результат;

КонецФункции

// Возвращает полные имена всех объектов верхнего уровня, которые есть в расширениях
// информационной базы (заимствованных и новых).
//
// Возвращаемое значение:
//   Массив из Строка - отсортированные полные имена без повторов.
//
Функция ОбъектыРасширений() Экспорт

	Имена = Новый СписокЗначений;

	Расширения = РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.БазаДанных);
	Для Каждого Расширение Из Расширения Цикл
		МетаданныеРасширения = Новый ОбъектМетаданныхКонфигурация(Расширение.ПолучитьДанные());
		Для Каждого ОбъектРасширения Из ОбъектыВерхнегоУровня(МетаданныеРасширения) Цикл
			ПолноеИмя = ОбъектРасширения.ПолноеИмя();
			Если Имена.НайтиПоЗначению(ПолноеИмя) = Неопределено Тогда
				Имена.Добавить(ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Имена.СортироватьПоЗначению();
	Возврат Имена.ВыгрузитьЗначения();

КонецФункции

// Проверяет, меняют ли объект расширения, активные в текущем сеансе.
//
// Параметры:
//   ПолноеИмя - Строка - полное имя объекта.
//
// Возвращаемое значение:
//   Булево, Неопределено - Неопределено, если объекта нет в основной конфигурации.
//
Функция ЕстьИзмененияВСеансе(Знач ПолноеИмя) Экспорт

	ОбъектКонфигурации = Метаданные.НайтиПоПолномуИмени(СокрЛП(ПолноеИмя));
	Если ОбъектКонфигурации = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбъектКонфигурации.ЕстьИзмененияРасширениямиКонфигурации();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СоставОбъекта

Функция НоваяТаблицаИзменений()

	ОписаниеСтроки = Новый ОписаниеТипов("Строка");
	ОписаниеБулево = Новый ОписаниеТипов("Булево");

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Объект", ОписаниеСтроки, "Объект");
	Таблица.Колонки.Добавить("Расширение", ОписаниеСтроки, "Расширение");
	Таблица.Колонки.Добавить("Синоним", ОписаниеСтроки, "Синоним");
	Таблица.Колонки.Добавить("Версия", ОписаниеСтроки, "Версия");
	Таблица.Колонки.Добавить("Активно", ОписаниеБулево, "Активно");
	Таблица.Колонки.Добавить("БезопасныйРежим", ОписаниеБулево, "Безопасный режим");
	Таблица.Колонки.Добавить("ИзменяетСтруктуруДанных", ОписаниеБулево, "Изменяет структуру данных");
	Таблица.Колонки.Добавить("Назначение", ОписаниеСтроки, "Назначение");
	Таблица.Колонки.Добавить("Элемент", ОписаниеСтроки, "Элемент");
	Таблица.Колонки.Добавить("ВидИзменения", ОписаниеСтроки, "Вид изменения");
	Таблица.Колонки.Добавить("Подробности", ОписаниеСтроки, "Подробности");
	Таблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

// Собирает строки одного объекта одного расширения и переносит их в результат.
// Сведения - см. НовыеСведенияОбъекта.
Процедура ДобавитьИзмененияОбъекта(Результат, Расширение, ОбъектРасширения, Сведения, ТолькоИзменения)

	ПолноеИмя = ОбъектРасширения.ПолноеИмя();
	Строки = НоваяТаблицаИзменений();

	СтрокаОбъекта = ДобавитьСтроку(Строки, Расширение, ПолноеИмя, "(объект)", ОбъектРасширения);
	СтрокаОбъекта.Порядок = 0;
	СтрокаОбъекта.Подробности = Сведения.Ошибка;

	Для Каждого ИмяКоллекции Из ИменаПодчиненныхКоллекций() Цикл

		Коллекция = КоллекцияИлиНеопределено(ОбъектРасширения, ИмяКоллекции.Ключ);
		Если Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Элемент Из Коллекция Цикл
			ИмяЭлемента = ИмяКоллекции.Значение + "." + Элемент.Имя;
			НоваяСтрока = ДобавитьСтроку(Строки, Расширение, ПолноеИмя, ИмяЭлемента, Элемент);

			Если ИмяКоллекции.Ключ = "Формы" Тогда
				ИзмененияФормы = Сведения.Формы[Элемент.Имя];
				Если ЗначениеЗаполнено(ИзмененияФормы) И НоваяСтрока.Порядок = 2 Тогда
					НоваяСтрока.ВидИзменения = "заимствован, изменен";
					НоваяСтрока.Подробности = ИзмененияФормы;
					НоваяСтрока.Порядок = 1;
				КонецЕсли;
			ИначеЕсли ИмяКоллекции.Ключ = "ТабличныеЧасти" Тогда
				Для Каждого РеквизитТЧ Из Элемент.Реквизиты Цикл
					ДобавитьСтроку(Строки, Расширение, ПолноеИмя,
						ИмяЭлемента + ".Реквизит." + РеквизитТЧ.Имя, РеквизитТЧ);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Для Каждого Модуль Из Сведения.Модули Цикл
		НоваяСтрока = ДобавитьСтроку(Строки, Расширение, ПолноеИмя, Модуль.Элемент, Неопределено);
		НоваяСтрока.ВидИзменения = Модуль.ВидИзменения;
		НоваяСтрока.Подробности = Модуль.Подробности;
		НоваяСтрока.Порядок = 1;
	КонецЦикла;

	Если ТолькоИзменения Тогда
		// Объект без своих элементов, кода и изменений форм скрывается, если его данные
		// удалось проверить; иначе его лучше показать, чем потерять изменение.
		ЕстьИзменения = СтрокаОбъекта.ВидИзменения = "новый"
			Или ЗначениеЗаполнено(Сведения.Ошибка)
			Или Строки.Найти(1, "Порядок") <> Неопределено;
		Если Не ЕстьИзменения Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Для Каждого СтрокаИзменения Из Строки Цикл
		Если ТолькоИзменения И СтрокаИзменения.Порядок = 2 Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаИзменения);
	КонецЦикла;

КонецПроцедуры

// ЭлементМетаданных - ОбъектМетаданных, Неопределено - для строк модулей.
Функция ДобавитьСтроку(Строки, Расширение, ПолноеИмя, ИмяЭлемента, ЭлементМетаданных)

	НоваяСтрока = Строки.Добавить();
	НоваяСтрока.Объект = ПолноеИмя;
	НоваяСтрока.Расширение = Расширение.Имя;
	НоваяСтрока.Синоним = Расширение.Синоним;
	НоваяСтрока.Версия = Расширение.Версия;
	НоваяСтрока.Активно = Расширение.Активно;
	НоваяСтрока.БезопасныйРежим = Расширение.БезопасныйРежим;
	НоваяСтрока.ИзменяетСтруктуруДанных = Расширение.ИзменяетСтруктуруДанных();
	НоваяСтрока.Назначение = Строка(Расширение.Назначение);
	НоваяСтрока.Элемент = ИмяЭлемента;

	Если ЭлементМетаданных = Неопределено Тогда
		Возврат НоваяСтрока;
	КонецЕсли;

	// Новые элементы идут раньше заимствованных: заимствованных реквизитов бывают
	// десятки, и новые среди них теряются.
	Если ЭлементМетаданных.ПринадлежностьОбъекта = Метаданные.СвойстваОбъектов.ПринадлежностьОбъекта.Заимствованный Тогда
		НоваяСтрока.ВидИзменения = "заимствован";
		НоваяСтрока.Порядок = 2;
	Иначе
		НоваяСтрока.ВидИзменения = "новый";
		НоваяСтрока.Порядок = 1;
	КонецЕсли;

	Возврат НоваяСтрока;

КонецФункции

// Разные виды объектов имеют разный набор коллекций, отсутствующая дает исключение.
Функция КоллекцияИлиНеопределено(ОбъектМетаданных, ИмяКоллекции)

	Попытка
		Возврат ОбъектМетаданных[ИмяКоллекции];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ОбъектыВерхнегоУровня(МетаданныеРасширения)

	Объекты = Новый Массив;
	Для Каждого ИмяКоллекции Из ИменаКоллекцийВерхнегоУровня() Цикл
		Коллекция = КоллекцияИлиНеопределено(МетаданныеРасширения, ИмяКоллекции);
		Если Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОбъектРасширения Из Коллекция Цикл
			Объекты.Добавить(ОбъектРасширения);
		КонецЦикла;
	КонецЦикла;

	Возврат Объекты;

КонецФункции

