#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Элементы.ПолноеИмяОбъекта.СписокВыбора.ЗагрузитьЗначения(ОбработкаОбъект.ОбъектыРасширений());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОбработка(Команда)

	СформироватьНаСервере();

	// Показываем расширения по каждому объекту; элементы раскрываются по требованию,
	// заимствованных реквизитов бывают десятки.
	Для Каждого СтрокаОбъекта Из Дерево.ПолучитьЭлементы() Цикл
		Элементы.Дерево.Развернуть(СтрокаОбъекта.ПолучитьИдентификатор(), Ложь);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Изменения = ОбработкаОбъект.ИзмененияОбъекта(ПолноеИмяОбъекта, ТолькоИзменения);

	ДеревоЗначений = РеквизитФормыВЗначение("Дерево");
	ДеревоЗначений.Строки.Очистить();

	СтрокаОбъекта = Неопределено;
	СтрокаРасширения = Неопределено;
	Для Каждого Изменение Из Изменения Цикл

		Если СтрокаОбъекта = Неопределено Или СтрокаОбъекта.Представление <> Изменение.Объект Тогда
			СтрокаОбъекта = ДеревоЗначений.Строки.Добавить();
			СтрокаОбъекта.Представление = Изменение.Объект;
			СтрокаРасширения = Неопределено;
		КонецЕсли;

		Если СтрокаРасширения = Неопределено Или СтрокаРасширения.Представление <> Изменение.Расширение Тогда
			СтрокаРасширения = СтрокаОбъекта.Строки.Добавить();
			СтрокаРасширения.Представление = Изменение.Расширение;
			СтрокаРасширения.Синоним = Изменение.Синоним;
			СтрокаРасширения.Версия = Изменение.Версия;
			СтрокаРасширения.Активно = ПредставлениеФлага(Изменение.Активно);
			СтрокаРасширения.БезопасныйРежим = ПредставлениеФлага(Изменение.БезопасныйРежим);
			СтрокаРасширения.ИзменяетСтруктуруДанных = ПредставлениеФлага(Изменение.ИзменяетСтруктуруДанных);
			СтрокаРасширения.Назначение = Изменение.Назначение;
		КонецЕсли;

		СтрокаЭлемента = СтрокаРасширения.Строки.Добавить();
		СтрокаЭлемента.Представление = Изменение.Элемент;
		СтрокаЭлемента.ВидИзменения = Изменение.ВидИзменения;
		СтрокаЭлемента.Подробности = Изменение.Подробности;

	КонецЦикла;

	ЗначениеВРеквизитФормы(ДеревоЗначений, "Дерево");

	Сведения = ТекстСведений(ОбработкаОбъект, ДеревоЗначений.Строки.Количество());

КонецПроцедуры

&НаСервере
Функция ТекстСведений(ОбработкаОбъект, КоличествоОбъектов)

	Если Не ЗначениеЗаполнено(ПолноеИмяОбъекта) Тогда
		Возврат СтрШаблон("Объектов в расширениях: %1.", КоличествоОбъектов);
	КонецЕсли;

	ЕстьИзменения = ОбработкаОбъект.ЕстьИзмененияВСеансе(ПолноеИмяОбъекта);
	Если ЕстьИзменения = Неопределено Тогда
		ТекстСеанса = "объекта нет в основной конфигурации";
	ИначеЕсли ЕстьИзменения Тогда
		ТекстСеанса = "активные расширения сеанса его изменяют";
	Иначе
		ТекстСеанса = "активные расширения сеанса его не изменяют";
	КонецЕсли;

	Если КоличествоОбъектов = 0 И ТолькоИзменения Тогда
		ТекстРасширений = "расширения базы его не изменяют (только заимствуют или не содержат)";
	ИначеЕсли КоличествоОбъектов = 0 Тогда
		ТекстРасширений = "ни в одном расширении базы объект не найден";
	Иначе
		ТекстРасширений = "найден в расширениях (см. ниже)";
	КонецЕсли;

	Возврат СтрШаблон("%1: %2; %3.", ПолноеИмяОбъекта, ТекстРасширений, ТекстСеанса);

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеФлага(Значение)
	Возврат ?(Значение, "Да", "Нет");
КонецФункции

#КонецОбласти
